{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lang Learn Prototype",
  "version": "0.0.0",
  "identifier": "io.github.lang-learn.prototype",
  "build": {
    "beforeDevCommand": "npm run stage:prototype",
    "beforeBuildCommand": "npm run stage:prototype",
    "frontendDist": "../dist-web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lang Learn — P00b Prototype",
        "url": "app/prototype/index.html",
        "create": false,
        "width": 900,
        "height": 700
      }
    ],
    "security": {
      "capabilities": ["prototype"],
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": { "active": false }
}
