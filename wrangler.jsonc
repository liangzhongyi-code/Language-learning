{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lang-learn",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "node tools/build-site.mjs"
  },
  "assets": {
    "directory": "./dist-site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lang-learn",
      "database_id": "71b237b9-227f-41d5-a357-94071fb24fec",
      "migrations_dir": "worker/migrations"
    }
  ],
  "vars": {
    "ACCESS_MODE": "allowlist",
    "GOOGLE_CLIENT_ID": "621300033629-bf4tcqujr8ip46djqtn17mr97c579pmg.apps.googleusercontent.com",
    "SITE_ORIGIN": "https://lang-learn.lang-learn.workers.dev"
  },
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  }
}
